# Supabase → Project Settings → API (anon key is safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Node.js API (server/ folder)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site URL (used for sitemap / SEO)
NEXT_PUBLIC_SITE_URL=https://www.collegeolo.com

# Server-to-server URL of the Node API (used by Next.js to load translated menus).
# On the VPS this can be http://127.0.0.1:4000
API_URL_INTERNAL=http://localhost:4000

# Show the WhatsApp tab on /login (after the Supabase Send SMS hook + WhatsApp templates are set up)
# NEXT_PUBLIC_WHATSAPP_LOGIN=on

# Guest mock tests without signup (also enable "Allow anonymous sign-ins" in Supabase)
NEXT_PUBLIC_GUEST_TESTS=off

# Who runs the site — shown on About, Contact, Privacy, Terms and in Google's Organization data.
# Leave empty what you don't want shown; nothing is invented.
NEXT_PUBLIC_ORG_LEGAL_NAME=
NEXT_PUBLIC_ORG_FOUNDER=
NEXT_PUBLIC_ORG_FOUNDER_ROLE=Founder
NEXT_PUBLIC_ORG_FOUNDER_NOTE=
NEXT_PUBLIC_ORG_STARTED=2026
NEXT_PUBLIC_ORG_CITY=
NEXT_PUBLIC_ORG_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=hello@collegeolo.com
NEXT_PUBLIC_CONTACT_PHONE=
# Required by the IT Rules, 2021 (name + contact must be published)
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_GRIEVANCE_EMAIL=
# Your social profiles, comma separated (helps Google connect the brand)
NEXT_PUBLIC_ORG_SOCIAL=
NEXT_PUBLIC_POLICY_DATE=21 November 2026
# Languages Google may index (only ones with properly translated pages). Others stay usable but noindex.
HREFLANG_LANGS=en,hi
