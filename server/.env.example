PORT=4000
# Comma-separated list of allowed front-end origins
CORS_ORIGIN=http://localhost:3000,https://studyearnstay.com,https://www.studyearnstay.com

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key — SECRET, server only, never put this in the Next.js app
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI assistant (optional). Without a key the chat widget returns matching links only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5   # chatbot
# Mock-test AI — a pool of providers with automatic failover (see services/llm.js and the README).
# Add every free key you have; the double-check uses a different provider from the writer.
# GEMINI_API_KEY=            # https://aistudio.google.com/apikey
# GROQ_API_KEY=              # https://console.groq.com/keys
# SAMBANOVA_API_KEY=         # https://cloud.sambanova.ai
# OPENROUTER_API_KEY=        # https://openrouter.ai/keys   (":free" models)
# NVIDIA_API_KEY=            # https://build.nvidia.com
# MISTRAL_API_KEY=           # https://console.mistral.ai
# CEREBRAS_API_KEY=          # https://cloud.cerebras.ai
# COHERE_API_KEY=            # https://dashboard.cohere.com/api-keys
# CLOUDFLARE_API_TOKEN=      # https://dash.cloudflare.com  (Workers AI)
# CLOUDFLARE_ACCOUNT_ID=
# OLLAMA_MODEL=qwen2.5:14b-instruct   # self-hosted; OLLAMA_URL=http://localhost:11434/v1
# LLM_BASE_URL= LLM_API_KEY= LLM_MODEL=   # any other OpenAI-compatible API (Sarvam, vLLM…)
# LLM_ANTHROPIC_MODEL=claude-sonnet-5-5   # when ANTHROPIC_API_KEY is set
# Override a model:  GROQ_MODEL=qwen/qwen3.8-27b    Change the order:  LLM_ORDER=gemini,groq,openrouter
# MOCK_SWEEPER=off          # stop auto-submitting expired tests / sending result emails
# MOCK_AUTOPILOT=off        # stop the hourly AI autopilot (switch it on/off in Admin → Mock tests → Autopilot)
# MOCK_AUTOPILOT_MINUTES=60

# ---- Worldwide data (all optional except where noted) ----
# Local job listings near each college / city. Get free keys:
#   Adzuna: https://developer.adzuna.com   (≈19 countries incl. India, UK, US, Canada, Australia, Germany)
#   Jooble: https://jooble.org/api/about   (60+ countries; free key has limited calls → results are cached)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
JOBS_CACHE_HOURS=12

# Translation for 30+ languages (menus are translated once and cached forever)
#   Google Cloud Translation Basic v2 — first 500K characters/month free
GOOGLE_TRANSLATE_API_KEY=
#   …or a LibreTranslate server instead of Google
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# OpenStreetMap services (free, no key). Use your own instances for heavy traffic.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Contact info sent with requests (OpenStreetMap / Wikidata policy)
HTTP_USER_AGENT=StudyEarnstay/1.0 (+https://studyearnstay.com; hello@studyearnstay.com)

# United States colleges with real tuition (College Scorecard). Free key: https://api.data.gov/signup/
COLLEGE_SCORECARD_API_KEY=

# Wikidata / Wikipedia / Wikimedia Commons (free, no key). Optional token raises Wikimedia rate limits:
# https://api.wikimedia.org → create a personal API token
WIKIMEDIA_ACCESS_TOKEN=
WIKIMEDIA_MIN_GAP_MS=800

# Exchange rates for "≈ fee in your currency" (free, no key)
FX_API_URL=https://open.er-api.com/v6/latest

# Payments — "Boost listing" for PG owners & employers (Razorpay, India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Prices in rupees per plan (days → price). Optional:
# BOOST_PRICES={"hostel":{"7":99,"30":299},"job":{"7":149,"30":399}}

# Outgoing email (lead sharing to partner colleges, visit/message notifications). Optional.
# SMTP_URL=smtps://user:password@smtp.zoho.in:465
# MAIL_FROM=StudyEarnstay <hello@studyearnstay.com>
SITE_URL=https://studyearnstay.com

# WhatsApp (Meta Cloud API) — login codes, notifications, job alerts. Leave empty until your number is connected.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_OTP_TEMPLATE=login_code        # Authentication template (copy-code button)
# WHATSAPP_NOTIFY_TEMPLATE=ses_update     # Utility template, 2 body variables
# WHATSAPP_TEMPLATE=job_alert             # optional, Utility template, 1 body variable (else the notify template is used)
# WHATSAPP_TEMPLATE_LANG=en
# Supabase Auth → Hooks → Send SMS (HTTPS) → https://<api>/api/hooks/send-sms ; paste the generated secret:
# SEND_SMS_HOOK_SECRET=v1,whsec_...
# NOTIFICATIONS=off   # to stop the notification sender
# Job alerts (hourly) use SMTP_URL and/or WhatsApp above.
# SITE_URL=https://studyearnstay.com
# JOB_ALERTS=off   # to disable the scheduler

# AI explanations / hints limits
AI_EXPLAIN_PER_DAY=20
AI_HINTS_PER_TEST=3

# Campus chat: messages older than this are deleted daily (posts stay)
CHAT_RETENTION_MONTHS=6
# TURN relay for voice/video calls (optional) — Cloudflare Calls TURN, or your own coturn
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Selfie verification needs an AI that reads photos: GEMINI_API_KEY (free) or ANTHROPIC_API_KEY, or e.g. GROQ_VISION_MODEL=...

# Daily refresh of which college / city pages have enough real content for Google (migration 018)
SEO_REFRESH=on

# Automatic photos & details (Wikidata / Wikipedia / Wikimedia Commons) + review invitations to real students
AUTOFILL=on
AUTOFILL_EVERY_HOURS=6
AUTOFILL_BATCH=300
REVIEW_INVITES=on
REVIEW_INVITES_BATCH=500

# Exam news by email (free GDELT news index, worldwide; Google News is not used — its terms forbid commercial use)
EXAM_NEWS=on
EXAM_NEWS_EVERY_HOURS=3
EXAM_NEWS_PER_RUN=40
EXAM_NEWS_DIGEST_HOUR=7          # India time; at most one email per student per EXAM_NEWS_MIN_GAP_HOURS
EXAM_NEWS_MIN_GAP_HOURS=20
EXAM_NEWS_PER_EXAM=5
EXAM_NEWS_LANGS=english,hindi    # GDELT language names; empty = all languages
EXAM_NEWS_AI=on                  # AI double-check when an AI key is configured
# NEWSDATA_API_KEY=              # optional second source (newsdata.io)
