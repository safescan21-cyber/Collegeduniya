PORT=4000
# Comma-separated list of allowed front-end origins
CORS_ORIGIN=http://localhost:3000,https://studyearnstay.com,https://www.studyearnstay.com

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key — SECRET, server only, never put this in the Next.js app
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI assistant (optional). Without a key the chat widget returns matching links only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Worldwide data (all optional except where noted) ----
# Local job listings near each college / city. Get free keys:
#   Adzuna: https://developer.adzuna.com   (≈19 countries incl. India, UK, US, Canada, Australia, Germany)
#   Jooble: https://jooble.org/api/about   (60+ countries; free key has limited calls → results are cached)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
JOBS_CACHE_HOURS=12

# Translation for 30+ languages (menus are translated once and cached forever)
#   Google Cloud Translation Basic v2 — first 500K characters/month free
GOOGLE_TRANSLATE_API_KEY=
#   …or a LibreTranslate server instead of Google
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# OpenStreetMap services (free, no key). Use your own instances for heavy traffic.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Contact info sent with requests (OpenStreetMap / Wikidata policy)
HTTP_USER_AGENT=StudyEarnstay/1.0 (+https://studyearnstay.com; hello@studyearnstay.com)

# United States colleges with real tuition (College Scorecard). Free key: https://api.data.gov/signup/
COLLEGE_SCORECARD_API_KEY=

# Wikidata / Wikipedia / Wikimedia Commons (free, no key). Optional token raises Wikimedia rate limits:
# https://api.wikimedia.org → create a personal API token
WIKIMEDIA_ACCESS_TOKEN=
WIKIMEDIA_MIN_GAP_MS=800

# Exchange rates for "≈ fee in your currency" (free, no key)
FX_API_URL=https://open.er-api.com/v6/latest

# Payments — "Boost listing" for PG owners & employers (Razorpay, India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Prices in rupees per plan (days → price). Optional:
# BOOST_PRICES={"hostel":{"7":99,"30":299},"job":{"7":149,"30":399}}

# Outgoing email (lead sharing to partner colleges, visit/message notifications). Optional.
# SMTP_URL=smtps://user:password@smtp.zoho.in:465
# MAIL_FROM=StudyEarnstay <hello@studyearnstay.com>
SITE_URL=https://studyearnstay.com

# Job alerts (hourly). Email uses SMTP_URL above. Optional WhatsApp Cloud API (approved template with one body variable):
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=job_alert
# WHATSAPP_TEMPLATE_LANG=en
# SITE_URL=https://studyearnstay.com
# JOB_ALERTS=off   # to disable the scheduler
