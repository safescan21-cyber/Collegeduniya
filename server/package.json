{
  "name": "collegeolo-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Collegeolo.com Node.js API — admin, uploads, visitor analytics",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "import:cities": "node scripts/import-cities.js",
    "import:universities": "node scripts/import-universities.js",
    "import:us": "node scripts/import-us.js",
    "import:uk": "node scripts/import-uk.js",
    "import:aishe": "node scripts/import-aishe.js",
    "import:nirf": "node scripts/import-nirf.js",
    "import:nirf-data": "node scripts/import-nirf-data.js",
    "import:eter": "node scripts/import-eter.js",
    "import:sheet": "node scripts/import-sheet.js",
    "enrich": "node scripts/enrich.js",
    "import:india": "node scripts/import-india.js",
    "import:cities:india": "node scripts/import-cities.js IN --names",
    "import:cutoffs": "node scripts/import-cutoffs.js",
    "import:rankings": "node scripts/import-rankings.js",
    "mock:setup": "node scripts/mock-setup.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
