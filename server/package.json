    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^6.10.1",
    "unpdf": "^2.2.3",
    "web-push": "^3.6.7",
    "yauzl": "^3.4.0",
    "zod": "^3.23.8"
  }
